# Copy this file to .env and fill in your own values.
# Never commit .env or paste real keys into chat or code.

# OpenAI API key for the agent's model calls
OPENAI_API_KEY=
# Model name you have access to, for example one from platform.openai.com
OPENAI_MODEL=gpt-4o-mini

# Firebase project used by Quillo
FIREBASE_PROJECT_ID=quillo-8669c

# Path to a Firebase service account JSON file (keep that file out of git)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Login email of the Quillo user whose data the agent reads
QUILLO_USER_EMAIL=mouryamanoj2505@gmail.com

# Environment: development or production
APP_ENV=development

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
